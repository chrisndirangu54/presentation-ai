generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String?
    access_token             String?
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String?
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

enum UserRole {
    SUPER_ADMIN
    ADMIN
    USER
}

enum WorkspaceRole {
    OWNER
    ADMIN
    EDITOR
    COMMENTER
    VIEWER
}

enum SubscriptionPlan {
    FREE
    PRO
    TEAM
    BUSINESS
    ENTERPRISE
}

enum SourceKind {
    PDF
    DOCX
    PPTX
    XLSX
    CSV
    URL
    YOUTUBE
    GOOGLE_DRIVE
    TEXT
    IMAGE
    AUDIO
}

enum ExportFormat {
    PPTX
    PDF
    GOOGLE_SLIDES
    DOCX
    XLSX
    CSV
    PNG
    JPG
    SVG
    HTML
    MARKDOWN
    JSON
}

enum ExportStatus {
    QUEUED
    RUNNING
    SUCCEEDED
    FAILED
}

enum ProviderKind {
    TEXT
    IMAGE
    VIDEO
    EMBEDDING
    SPEECH
    SEARCH
}

enum ArtifactKind {
    PRESENTATION
    DOCUMENT
    SPREADSHEET
    INFOGRAPHIC
    CHART
    FLOWCHART
    DIAGRAM
    MIND_MAP
    TIMELINE
    DASHBOARD
    POSTER
    SOCIAL_CAROUSEL
    ONE_PAGER
    WHITEPAPER
}

enum TemplateStatus {
    DRAFT
    PENDING_REVIEW
    PUBLISHED
    REJECTED
    ARCHIVED
}

enum TemplateLicense {
    PERSONAL
    COMMERCIAL
    EXTENDED
    TEAM
    ENTERPRISE
}

enum MarketplaceOrderStatus {
    PENDING
    PAID
    REFUNDED
    CANCELLED
}

enum VisualSpecKind {
    CHART
    FLOWCHART
    DIAGRAM
    MIND_MAP
    TIMELINE
    MAP
    INFOGRAPHIC
}

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    password      String?
    emailVerified DateTime?
    image         String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @default(now()) @updatedAt
    headline      String?   @db.VarChar(100)
    bio           String?   @db.Text
    interests     String[]
    location      String?
    website       String?
    accounts      Account[]

    role      UserRole @default(USER)
    hasAccess Boolean  @default(false)

    documents        BaseDocument[]
    favorites        FavoriteDocument[]
    CustomTheme      CustomTheme[]
    GeneratedImage   GeneratedImage[]
    memberships      WorkspaceMember[]
    ownedWorkspaces  Workspace[]          @relation("WorkspaceOwner")
    comments         PresentationComment[]
    usageEvents      UsageEvent[]
    auditLogs        AuditLog[]            @relation("AuditActor")
    apiKeys          ApiCredential[]
    creatorProfile   CreatorProfile?
    marketplaceTemplates MarketplaceTemplate[] @relation("TemplateCreator")
    templatePurchases TemplatePurchase[] @relation("TemplateBuyer")
    templateReviews   TemplateReview[]
}

model Workspace {
    id             String           @id @default(cuid())
    name           String
    slug           String           @unique
    ownerId        String
    owner          User             @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
    plan           SubscriptionPlan @default(FREE)
    brandName      String?
    createdAt      DateTime         @default(now())
    updatedAt      DateTime         @updatedAt
    members        WorkspaceMember[]
    documents      BaseDocument[]
    brandKits      BrandKit[]
    templates      PresentationTemplate[]
    providerConfigs ModelProviderConfig[]
    webhooks       WebhookEndpoint[]
    auditLogs      AuditLog[]
    apiKeys        ApiCredential[]
    sources        SourceDocument[]
    artifacts      Artifact[]
    marketplaceTemplates MarketplaceTemplate[]

    @@index([ownerId])
}

model WorkspaceMember {
    id          String        @id @default(cuid())
    workspaceId String
    userId      String
    role        WorkspaceRole @default(EDITOR)
    createdAt   DateTime      @default(now())
    workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([workspaceId, userId])
    @@index([userId])
}

enum DocumentType {
    NOTE
    DOCUMENT
    DRAWING
    DESIGN
    STICKY_NOTES
    MIND_MAP
    RAG
    RESEARCH_PAPER
    FLIPBOOK
    PRESENTATION
    INFOGRAPHIC
    SPREADSHEET
    FLOWCHART
    DIAGRAM
    DASHBOARD
    POSTER
    SOCIAL_CAROUSEL
    ONE_PAGER
    WHITEPAPER
}

model BaseDocument {
    id           String        @id @default(cuid())
    title        String
    type         DocumentType
    userId       String
    user         User          @relation(fields: [userId], references: [id])
    workspaceId  String?
    workspace    Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
    thumbnailUrl String?
    createdAt    DateTime      @default(now())
    updatedAt    DateTime      @updatedAt
    isPublic     Boolean       @default(false)
    documentType String
    presentation Presentation?
    artifact     Artifact?
    favorites    FavoriteDocument[]

    @@index([workspaceId])
}

model Presentation {
    id                String       @id @default(cuid())
    content           Json
    theme             String       @default("default")
    imageModel        String?
    presentationStyle String?
    language          String?      @default("en-US")
    outline           String[]
    base              BaseDocument @relation(fields: [id], references: [id], onDelete: Cascade)
    templateId        String?
    customThemeId     String?
    customTheme       CustomTheme? @relation(fields: [customThemeId], references: [id])
    objective         String?
    audience          String?
    durationMinutes   Int?
    narrativePlan     Json?
    versions          PresentationVersion[]
    comments          PresentationComment[]
    citations         Citation[]
    exportJobs        ExportJob[]
}

model PresentationVersion {
    id             String       @id @default(cuid())
    presentationId String
    version        Int
    snapshot       Json
    summary        String?
    createdById    String?
    createdAt      DateTime     @default(now())
    presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)

    @@unique([presentationId, version])
    @@index([presentationId, createdAt])
}

model PresentationComment {
    id             String       @id @default(cuid())
    presentationId String
    authorId       String
    slideId        String?
    parentId       String?
    body           String       @db.Text
    resolvedAt     DateTime?
    createdAt      DateTime     @default(now())
    updatedAt      DateTime     @updatedAt
    presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
    author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
    parent         PresentationComment? @relation("CommentThread", fields: [parentId], references: [id])
    replies        PresentationComment[] @relation("CommentThread")

    @@index([presentationId, slideId])
}

model SourceDocument {
    id          String     @id @default(cuid())
    workspaceId String
    name        String
    kind        SourceKind
    uri         String?
    mimeType    String?
    contentHash String?
    metadata    Json?
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt
    workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    citations   Citation[]

    @@index([workspaceId, createdAt])
}

model Citation {
    id             String          @id @default(cuid())
    presentationId String
    sourceId       String
    slideId        String?
    claim          String?         @db.Text
    locator        String?
    url            String?
    createdAt      DateTime        @default(now())
    presentation   Presentation    @relation(fields: [presentationId], references: [id], onDelete: Cascade)
    source         SourceDocument  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

    @@index([presentationId, slideId])
}

model BrandKit {
    id          String    @id @default(cuid())
    workspaceId String
    name        String
    logoUrl     String?
    colors      Json
    typography  Json
    voice       Json?
    rules       Json?
    isDefault   Boolean   @default(false)
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

    @@index([workspaceId])
}

model PresentationTemplate {
    id          String    @id @default(cuid())
    workspaceId String
    name        String
    description String?
    content     Json
    category    String?
    isPublic    Boolean   @default(false)
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

    @@index([workspaceId, category])
}

model ModelProviderConfig {
    id           String       @id @default(cuid())
    workspaceId  String
    provider     String
    kind         ProviderKind
    model        String
    enabled      Boolean      @default(true)
    isDefault    Boolean      @default(false)
    settings     Json?
    secretRef    String?
    createdAt    DateTime     @default(now())
    updatedAt    DateTime     @updatedAt
    workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

    @@index([workspaceId, kind])
}

model ApiCredential {
    id          String    @id @default(cuid())
    name        String
    provider    String
    encrypted   String
    lastFour    String?
    workspaceId String?
    userId      String?
    createdAt   DateTime  @default(now())
    rotatedAt   DateTime?
    workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([workspaceId])
    @@index([userId])
}

model WebhookEndpoint {
    id          String    @id @default(cuid())
    workspaceId String
    url         String
    events      String[]
    secretRef   String?
    active      Boolean   @default(true)
    createdAt   DateTime  @default(now())
    workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

    @@index([workspaceId])
}

model ExportJob {
    id             String       @id @default(cuid())
    presentationId String
    format         ExportFormat
    status         ExportStatus @default(QUEUED)
    outputUrl      String?
    error          String?
    options        Json?
    createdAt      DateTime     @default(now())
    updatedAt      DateTime     @updatedAt
    presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)

    @@index([presentationId, createdAt])
}

model UsageEvent {
    id        String   @id @default(cuid())
    userId    String
    workspaceId String?
    feature   String
    provider  String?
    model     String?
    units     Int      @default(1)
    costUsd   Decimal? @db.Decimal(12, 6)
    metadata  Json?
    createdAt DateTime @default(now())
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, createdAt])
    @@index([workspaceId, createdAt])
}

model AuditLog {
    id          String    @id @default(cuid())
    workspaceId String?
    actorId     String?
    action      String
    targetType  String?
    targetId    String?
    metadata    Json?
    ipHash      String?
    createdAt   DateTime  @default(now())
    workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    actor       User?      @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

    @@index([workspaceId, createdAt])
    @@index([actorId, createdAt])
}

model CustomTheme {
    id            String         @id @default(cuid())
    name          String
    description   String?
    userId        String
    user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    logoUrl       String?
    isPublic      Boolean        @default(false)
    createdAt     DateTime       @default(now())
    updatedAt     DateTime       @updatedAt
    themeData     Json
    presentations Presentation[]

    @@index([userId])
}

model FavoriteDocument {
    id         String       @id @default(uuid())
    documentId String
    document   BaseDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
    userId     String
    user       User         @relation(fields: [userId], references: [id])
}

model GeneratedImage {
    id        String   @id @default(cuid())
    url       String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    prompt    String
}


model Artifact {
    id          String       @id @default(cuid())
    baseId      String       @unique
    base        BaseDocument @relation(fields: [baseId], references: [id], onDelete: Cascade)
    workspaceId String?
    workspace   Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
    kind        ArtifactKind
    content     Json
    layout      Json?
    style       Json?
    data        Json?
    metadata    Json?
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt
    visualSpecs VisualSpec[]

    @@index([workspaceId, kind])
}

model VisualSpec {
    id         String         @id @default(cuid())
    artifactId String
    artifact   Artifact       @relation(fields: [artifactId], references: [id], onDelete: Cascade)
    kind       VisualSpecKind
    title      String?
    spec       Json
    data       Json?
    altText    String?
    createdAt  DateTime       @default(now())
    updatedAt  DateTime       @updatedAt

    @@index([artifactId, kind])
}

model CreatorProfile {
    id             String    @id @default(cuid())
    userId         String    @unique
    user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    displayName    String
    bio            String?   @db.Text
    avatarUrl      String?
    website        String?
    verified       Boolean   @default(false)
    rating         Float     @default(0)
    totalSales     Int       @default(0)
    totalDownloads Int       @default(0)
    payoutProvider String?
    payoutRef      String?
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @updatedAt
}

model MarketplaceTemplate {
    id             String          @id @default(cuid())
    creatorId      String
    creator        User            @relation("TemplateCreator", fields: [creatorId], references: [id], onDelete: Cascade)
    workspaceId    String?
    workspace      Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
    name           String
    slug           String          @unique
    description    String?         @db.Text
    kind           ArtifactKind
    category       String
    tags           String[]
    status         TemplateStatus  @default(DRAFT)
    isFree         Boolean         @default(true)
    priceCents     Int             @default(0)
    currency       String          @default("USD")
    license        TemplateLicense @default(PERSONAL)
    previewUrl     String?
    thumbnailUrl   String?
    source         Json
    manifest       Json
    featured       Boolean         @default(false)
    salesCount     Int             @default(0)
    downloadCount  Int             @default(0)
    averageRating  Float           @default(0)
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt
    versions       TemplateVersion[]
    purchases      TemplatePurchase[]
    reviews        TemplateReview[]

    @@index([creatorId, status])
    @@index([workspaceId, status])
    @@index([kind, category, status])
}

model TemplateVersion {
    id          String              @id @default(cuid())
    templateId  String
    template    MarketplaceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
    version     Int
    source      Json
    manifest    Json
    releaseNotes String?
    createdAt   DateTime            @default(now())

    @@unique([templateId, version])
}

model TemplatePurchase {
    id          String                 @id @default(cuid())
    templateId  String
    template    MarketplaceTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)
    buyerId     String
    buyer       User                   @relation("TemplateBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
    status      MarketplaceOrderStatus @default(PENDING)
    amountCents Int
    currency    String                 @default("USD")
    license     TemplateLicense
    providerRef String?
    createdAt   DateTime               @default(now())

    @@index([buyerId, createdAt])
    @@index([templateId, createdAt])
}

model TemplateReview {
    id         String              @id @default(cuid())
    templateId String
    template   MarketplaceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
    userId     String
    user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
    rating     Int
    title      String?
    body       String?             @db.Text
    createdAt  DateTime            @default(now())
    updatedAt  DateTime            @updatedAt

    @@unique([templateId, userId])
    @@index([templateId, createdAt])
}


enum PipelineStatus {
    DRAFT
    QUEUED
    RUNNING
    SUCCEEDED
    PARTIAL
    FAILED
    CANCELLED
}

enum ApprovalStatus {
    DRAFT
    PENDING
    APPROVED
    CHANGES_REQUESTED
    REJECTED
}

enum DataConnectionKind {
    GOOGLE_SHEETS
    EXCEL
    CSV
    SQL
    REST_API
    AIRTABLE
    NOTION
    POWER_BI
    TABLEAU
    SALESFORCE
    HUBSPOT
    CUSTOM
}

enum PublishVisibility {
    PRIVATE
    WORKSPACE
    PASSWORD
    PUBLIC
}

model SourceToManyJob {
    id              String         @id @default(cuid())
    workspaceId     String?
    userId          String
    sourceIds       String[]
    requestedKinds  ArtifactKind[]
    brandKitId      String?
    objective       String?
    audience        String?
    status          PipelineStatus @default(DRAFT)
    plan            Json?
    resultManifest  Json?
    error           String?
    createdAt       DateTime       @default(now())
    updatedAt       DateTime       @updatedAt

    @@index([workspaceId, createdAt])
    @@index([userId, createdAt])
}

model DataConnection {
    id              String             @id @default(cuid())
    workspaceId     String
    name            String
    kind            DataConnectionKind
    configuration   Json
    secretRef       String?
    refreshSchedule String?
    enabled         Boolean            @default(true)
    lastSyncedAt    DateTime?
    createdAt       DateTime           @default(now())
    updatedAt       DateTime           @updatedAt

    @@index([workspaceId, kind])
}

model AutomationWorkflow {
    id          String    @id @default(cuid())
    workspaceId String
    name        String
    description String?
    trigger     Json
    nodes       Json
    edges       Json
    enabled     Boolean   @default(false)
    lastRunAt   DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@index([workspaceId, enabled])
}

model ApprovalWorkflow {
    id          String    @id @default(cuid())
    workspaceId String
    name        String
    steps       Json
    rules       Json?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@index([workspaceId])
}

model ApprovalRequest {
    id          String         @id @default(cuid())
    workflowId  String
    artifactId  String
    requestedBy String
    currentStep Int            @default(0)
    status      ApprovalStatus @default(DRAFT)
    decisions   Json?
    createdAt   DateTime       @default(now())
    updatedAt   DateTime       @updatedAt

    @@index([workflowId, status])
    @@index([artifactId])
}

model ContentComponent {
    id          String    @id @default(cuid())
    workspaceId String
    name        String
    category    String
    content     Json
    tokens      Json?
    locked      Boolean   @default(false)
    approved    Boolean   @default(false)
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@index([workspaceId, category])
}

model KnowledgeEntry {
    id          String    @id @default(cuid())
    workspaceId String
    title       String
    content     String    @db.Text
    sourceUrl   String?
    metadata    Json?
    approved    Boolean   @default(false)
    validFrom   DateTime?
    validUntil  DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@index([workspaceId, approved])
}

model BrandPolicy {
    id          String    @id @default(cuid())
    workspaceId String
    name        String
    rules       Json
    severity    String    @default("warning")
    enabled     Boolean   @default(true)
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@index([workspaceId, enabled])
}

model ProvenanceRecord {
    id          String    @id @default(cuid())
    artifactId  String
    elementId   String?
    sourceIds   String[]
    provider    String?
    model       String?
    promptHash  String?
    metadata    Json?
    createdAt   DateTime  @default(now())

    @@index([artifactId, elementId])
}

model PublishedArtifact {
    id            String            @id @default(cuid())
    artifactId    String
    workspaceId   String?
    slug          String            @unique
    visibility    PublishVisibility @default(PRIVATE)
    passwordHash  String?
    customDomain  String?
    expiresAt     DateTime?
    settings      Json?
    publishedAt   DateTime          @default(now())
    updatedAt     DateTime          @updatedAt

    @@index([artifactId])
    @@index([workspaceId, publishedAt])
}

model EngagementEvent {
    id          String    @id @default(cuid())
    publishedId String
    sessionId   String?
    event       String
    elementId   String?
    durationMs  Int?
    metadata    Json?
    createdAt   DateTime  @default(now())

    @@index([publishedId, createdAt])
    @@index([event, createdAt])
}

model ExperimentVariant {
    id          String    @id @default(cuid())
    workspaceId String
    name        String
    artifactId  String
    experiment  String
    variant     String
    allocation  Int       @default(50)
    metrics     Json?
    active      Boolean   @default(true)
    createdAt   DateTime  @default(now())

    @@index([workspaceId, experiment])
}

model BulkGenerationJob {
    id          String         @id @default(cuid())
    workspaceId String
    userId      String
    templateId  String?
    inputSource Json
    mapping     Json
    outputKind  ArtifactKind
    status      PipelineStatus @default(QUEUED)
    totalRows   Int            @default(0)
    completed   Int            @default(0)
    failed      Int            @default(0)
    manifest    Json?
    createdAt   DateTime       @default(now())
    updatedAt   DateTime       @updatedAt

    @@index([workspaceId, createdAt])
}
